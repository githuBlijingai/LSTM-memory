ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://memory:change-me@localhost:5432/memory
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PORT=6379

OIDC_JWKS_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=
DEV_AUTH_ENABLED=false
DEV_AUTH_TOKEN=

# 宿主模型目录：compose 会将其只读挂载到容器内 /models。
# 本地模型路径请填写容器内路径，例如 EMBEDDING_MODEL_NAME=/models/bge-large-zh-v1.5、EVENT_MODEL_URI=/models/event-model。
MODEL_DIR=./models

# 后端镜像分两档：
# - INSTALL_ML=true（默认，ml 档）：装 CPU-only 的 torch/safetensors/transformers，事件编码可用。
# - INSTALL_ML=false（基础档）：精简镜像，不装 ML 依赖；事件编码会报 MODEL_UNAVAILABLE。
INSTALL_ML=true
# ml 档的 torch CPU wheel 索引（不含 CUDA 运行时），一般无需修改。
TORCH_CPU_INDEX_URL=https://mirror.sjtu.edu.cn/pytorch-wheels/cpu

EMBEDDING_PROVIDER=remote
EMBEDDING_MODEL_NAME=
EMBEDDING_MODEL_VERSION=
EMBEDDING_API_BASE=https://embedding.example.internal/v1
EMBEDDING_API_KEY=
RERANKER_ENABLED=true
RERANKER_PROVIDER=remote
RERANKER_MODEL_NAME=
RERANKER_MODEL_VERSION=
RERANKER_API_BASE=https://reranker.example.internal
RERANKER_API_KEY=
EVENT_MODEL_URI=
EVENT_MODEL_VERSION=
MODEL_DEVICE=cpu
LOCAL_MODEL_MIN_VRAM_GB=8
ALLOW_CPU_MODELS=false
MODEL_HTTP_TIMEOUT_SECONDS=30
BOOTSTRAP_NON_INTERACTIVE=true

# 入口防护（开发/测试默认值可直接联调；生产按需调整）。
SECURITY_HEADERS_ENABLED=true
CONTENT_SECURITY_POLICY=default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
# 生产启用 TLS 后再设置，例如 31536000；0 表示不发送 HSTS。
HSTS_MAX_AGE_SECONDS=0
MAX_REQUEST_BODY_BYTES=1048576
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_FEEDBACK_PER_MINUTE=120
RATE_LIMIT_SYNC_PER_HOUR=10
RATE_LIMIT_REDIS_PREFIX=rate_limit

# 观测：Prometheus 抓取与 OTel 链路导出。
METRICS_ENABLED=true
# 留空表示不鉴权；设置后 /metrics 需要 Authorization: Bearer <token>。
METRICS_TOKEN=
READINESS_MODEL_CHECK_ENABLED=true
READINESS_MODEL_CACHE_SECONDS=30
READINESS_MODEL_TIMEOUT_SECONDS=2
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=memory-system-api
OTEL_TRACES_SAMPLER_RATIO=0.1

BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_APP_ENV=development
