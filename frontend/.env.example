# FastAPI 服务地址，仅由 Next.js 服务端代理使用。
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_APP_ENV=development

# 仅用于本地开发；生产环境即使开启也不会生效。
DEV_AUTH_ENABLED=false
DEV_AUTH_TOKEN=
# Dev Auth 的主体与角色（viewer/operator/admin，逗号分隔）。
# 代理会以 `Authorization: Dev <subject>` 与 X-Dev-Roles 转发，后端需同时开启 DEV_AUTH_ENABLED。
DEV_AUTH_SUBJECT=dev-user
DEV_AUTH_ROLES=viewer
